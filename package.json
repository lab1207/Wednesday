{
  "name": "@lab1207/wednesday",
  "version": "0.2.0-beta.6",
  "description": "Free, open-source terminal harness that staffs small open models as a coding team: plan, approve, build, real tests, repair until green.",
  "license": "Apache-2.0",
  "author": "Vaibhav Hajare (lab1207)",
  "homepage": "https://wednesdaylabs.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lab1207/Wednesday.git"
  },
  "bugs": {
    "url": "https://github.com/lab1207/Wednesday/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agentic-coding",
    "coding-agent",
    "coding-assistant",
    "terminal",
    "cli",
    "tui",
    "llm",
    "local-llm",
    "ollama",
    "llama-cpp",
    "openrouter",
    "openai-compatible",
    "code-generation",
    "developer-tools",
    "apache-2.0"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "wednesday": "bin/wednesday.js",
    "wednesday-mcp": "bin/wednesday-mcp.js"
  },
  "files": [
    "bin/",
    "factory/",
    "crewai/src/",
    "crewai/pyproject.toml",
    "ecc/",
    "shared/config/",
    "shared/schemas/",
    "scripts/link-runtime.js",
    "THIRD_PARTY_LICENSES.md",
    "!factory/benchmark/",
    "!factory/tmp/",
    "!factory/tui/",
    "!factory/tui-ink/",
    "!factory/tui-pi/",
    "!factory/provision-worker.ts",
    "!factory/dsh-worker/deploy/",
    "!factory/dsh-worker/start-remote-server.ps1",
    "!factory/dsh-worker/pack-runtime.ts",
    "!factory/**/*.jsonl",
    "!factory/**/BUGS.md",
    "!factory/**/*-test.ts",
    "!factory/**/test.ts",
    "!crewai/src/**/*_test.py",
    "!**/__pycache__/",
    "!**/*.pyc",
    "!**/.venv/"
  ],
  "scripts": {
    "wednesday": "node bin/wednesday.js",
    "factory:mcp": "node --import tsx factory/mcp/server.ts",
    "factory:mcp:test": "node --import tsx factory/mcp/server-test.ts",
    "factory:test": "node --import tsx factory/orchestrator/test.ts",
    "factory:scan": "node --import tsx scripts/wednesday-scan.ts",
    "factory:route": "node --import tsx factory/model-router/router-prefix-test.ts && node --import tsx factory/dsh-worker/provider-route-test.ts",
    "factory:connector": "node --import tsx factory/openhands/connector-test.ts",
    "postinstall": "node scripts/link-runtime.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-skill": "0.0.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.0.1-rc.3",
    "tsx": "4.23.13",
    "undici": "^8.12.4"
  },
  "optionalDependencies": {
    "@lab1207/wednesday-runtime-win32-x64": "0.1.0-dev.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
