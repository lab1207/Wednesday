{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineeringTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "description",
    "project_path",
    "constraints",
    "priority"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "project_path": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    }
  }
}
