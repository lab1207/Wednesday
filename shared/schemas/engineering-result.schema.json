{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineeringResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "plan",
    "implementation_notes",
    "review_notes",
    "test_plan",
    "artifacts",
    "errors"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "working",
        "completed",
        "failed"
      ]
    },
    "plan": {
      "type": "string"
    },
    "implementation_notes": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "test_plan": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
